    "behavioral_notes": [
      {
        "element": "account.move._post / action_post",
        "observation": "Posting transitions state draft->posted, assigns the legal sequential number (via sequence.mixin / inalterable_hash for secured journals), validates the entry is balanced and complete, and freezes hash-locked fields. Requires group_account_invoice. Gives the document its accounting reality; not visible in metadata.",
        "source": "code-read"
      },
      {
        "element": "account.payment.action_post + _synchronize_to_moves",
        "observation": "account.payment is backed by an account.move: posting a payment drives state (draft->in_process->paid) and the model keeps its journal entry in sync via _synchronize_to_moves / _prepare_move_line_default_vals, debiting/crediting the journal's outstanding and liquidity accounts. The payment is a UI facade over a balanced move.",
        "source": "code-read"
      },
      {
        "element": "account.move.line.reconcile / _reconcile_plan",
        "observation": "Reconciling matches debit and credit move lines, creating account.partial.reconcile rows and, when fully matched, an account.full.reconcile; cross-currency matches spawn exchange-difference moves (_create_exchange_difference_moves). This is how invoices get marked paid and AR/AP residuals are cleared. Pure Python side-effect.",
        "source": "code-read"
      },
      {
        "element": "account.move.button_draft / button_cancel",
        "observation": "Resetting to draft unlinks analytic lines, detaches the generated invoice PDF for regeneration, and is blocked for hash-secured entries (need_cancel_request). Demonstrates the legal immutability constraints metadata cannot express.",
        "source": "code-read"
      },
      {
        "element": "account.report (engine-driven financial reports)",
        "observation": "account.report + account.report.line/expression form a declarative reporting engine: expressions carry formulas (domain/account_codes/aggregation/tax_tags engines) evaluated at render time to produce Balance Sheet, P&L, Tax and Aged reports. The numbers live in formulas, not stored fields.",
        "source": "code-read"
      },
      {
        "element": "frontend (OWL/JS)",
        "observation": "74 JS files, 26 OWL components, 40 registry registrations, 7 patches; asset bundles ['web._assets_primary_variables', 'web.assets_backend', 'web.assets_unit_tests'].",
        "source": "static"
      },
      {
        "element": "external integrations",
        "observation": "0 outbound HTTP call sites; SDKs ['requests', 'xmlrpc']; uses_api_keys=True; endpoints ['https://www.odoo.com/app/invoicing'].",
        "source": "static"
