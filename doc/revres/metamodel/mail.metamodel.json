    "capabilities": [
      "Record Collaboration (Chatter: message, log note, follow)",
      "Field-Change Tracking & Audit Log",
      "Email Communication (templates, outgoing queue, inbound gateway/aliases)",
      "Notification & Delivery Management (multi-channel: inbox/email/web push)",
