    "behavioral_notes": [
      {
        "element": "mail.thread.message_post",
        "observation": "Main entry point (mail_thread.py:2182). Resolves author -> creates a mail.message row (polymorphic model+res_id) -> attaches ir.attachment -> calls _notify_thread() -> _message_post_after_hook(). Adds full chatter to ANY model that inherits mail.thread via a single _inherit line; no schema change per host model.",
        "source": "code-read"
      },
      {
        "element": "mail.thread._notify_thread",
        "observation": "Fan-out pipeline (mail_thread.py:3262). Computes recipients (followers filtered by subtype + explicit partners), then dispatches across three channels: _notify_thread_by_inbox (creates mail.notification type=inbox + bus push to Discuss inbox), _notify_thread_by_email (creates mail.mail queue rows + mail.notification type=email, sent by cron via ir.mail_server), _notify_thread_by_web_push (browser/mobile push). Scheduled sends are deferred via mail.message.schedule.",
        "source": "code-read"
      },
      {
        "element": "mail.thread._message_track (tracking=True)",
        "observation": "On write to fields declared tracking=True, _message_track (mail_thread.py:644) diffs initial vs new values and creates mail.tracking.value rows (old/new pairs, typed columns) linked to an auto-posted mail.message; rendered inline in the chatter. Drives 'Stage changed' style audit logs. Not visible in metadata - lives in Python.",
        "source": "code-read"
      },
      {
        "element": "mail.thread.message_process / message_route",
        "observation": "Inbound email router (mail_thread.py:1424/1121). Parses MIME, then routes a raw email to the right record using References/In-Reply-To headers, mail.alias matching, and a signed hmac reply token; message_new/message_update hooks let a model turn an email into a new record or a reply (e.g. email -> new lead). fetchmail.server feeds it.",
        "source": "code-read"
      },
      {
        "element": "mail.notification (per-recipient/per-channel)",
        "observation": "One mail.message fans out to many mail.notification rows (one per recipient per channel: inbox/email/sms/snail) tracking notification_status (ready/sent/bounce/exception/canceled) + failure_type. Drives the red failed-delivery envelope and the Discuss inbox counter. Decouples a single message from multi-channel delivery state.",
        "source": "code-read"
      },
      {
        "element": "discuss.channel over bus",
        "observation": "discuss.channel itself inherits mail.thread, so chat messages are still mail.message rows. Real-time delivery rides the bus (websocket) via bus.listener.mixin; _notify_thread_by_inbox pushes posted channel messages to connected clients live. RTC voice/video uses discuss.channel.rtc.session (+ optional SFU/Twilio ICE servers).",
        "source": "code-read"
      },
      {
        "element": "frontend (OWL/JS)",
        "observation": "383 JS files, 40 OWL components, 40 registry registrations, 40 patches; asset bundles ['web._assets_primary_variables', 'web.assets_backend', 'web.assets_backend_lazy'].",
        "source": "static"
      },
      {
        "element": "external integrations",
        "observation": "6 outbound HTTP call sites; SDKs ['requests', 'xmlrpc']; uses_api_keys=True; endpoints ['http://www.w3.org/2000/svg', 'https://api.twilio.com/2010-04-01/Accounts/{account_sid}/Tokens.json'].",
        "source": "static"
      }
