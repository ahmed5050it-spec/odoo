  "classification": {
    "value_model": "support",
    "activity_class": "support",
    "apqc_category": "9.4 Manage internal controls / 13.0 Develop and Manage Business Capabilities (Information & Knowledge Management); operationally 3.5.4.8 Handle sales order inquiries (post-order) when chatter sits on a sale.order",
    "rationale": "mail is a cross-cutting SUPPORT subsystem (Stabell & Fjeldstad), not part of any single primary value chain. It supplies collaboration, communication, audit-trail, and notification infrastructure consumed by every primary activity. It is also a value NETWORK enabler: discuss.channel + bus + mail.notification mediate person-to-person and system-to-person exchange (network logic: linking parties and brokering messages). The dominant, foundational role is the mail.thread mixin inherited by ~42 modules to add chatter/activities/tracking everywhere - this is shared collaboration infrastructure, hence value_model=support / activity_class=support. APQC best fit is information/knowledge management (13.0) and internal communication; the apqc_odoo_map.tsv anchors the concrete operation 3.5.4.8 'Handle sales order inquiries' (mail.message message_post on sale.order, tagged support) as a representative application of the chatter on a primary-activity record."
  },
  "fit_to_standard": {
    "standard_capabilities": [
      "Chatter on any model (message / internal log note / followers) via mail.thread mixin",
      "Field-change tracking (tracking=True -> mail.tracking.value) and audit trail",
      "Email templates with dynamic rendering (mail.render.mixin) + outgoing queue (mail.mail) via ir.mail_server",
      "Inbound mail gateway with alias routing + reply-token threading (fetchmail.server / mail.alias)",
      "Multi-channel notification with per-recipient delivery tracking (mail.notification: inbox/email/web push)",
      "Scheduled activities + activity plans (mail.activity / mail.activity.mixin)",
      "Real-time Discuss channels, DMs, reactions, GIFs, link previews, voice/video calls (RTC)",
      "Email blacklist / bounce handling"
    ],
    "typical_fits": [
      "Add full chatter + activities to a custom model by inheriting ['mail.thread','mail.activity.mixin']",
      "Trigger automated notification emails from business transitions via mail.template",
      "Route an inbound mailbox into record creation via a mail.alias (e.g. support@ -> helpdesk ticket)",
      "Track key field changes for an audit log with tracking=True"
    ],
    "common_gaps": [
      "Custom notification routing / digest batching beyond follower-subtype logic",
      "Bespoke channel access policies beyond group_public_id record rules",
      "SFU/Twilio infrastructure for scaled RTC calls (external config required)",
      "Advanced email deliverability (DKIM/SPF, dedicated ESP) handled outside mail",
      "Tenor GIF / Google Translate / web push require external API keys"
    ],
    "drive_hints": [
      "odoo shell: r = env['res.partner'].browse(1); r.message_post(body='hi'); r.message_ids[:1].mapped(('subtype_id.name','message_type'))",
      "odoo shell: env['mail.message'].search_count([('model','=','sale.order')])  # chatter volume on a primary-activity model",
